PORT=3001

# PostgreSQL Database Connection (Supports Neon, Supabase, Vercel Postgres, AWS RDS, Render, Railway, Local)
# Example: postgresql://postgres:password@ep-fancy-pool-12345.us-east-2.aws.neon.tech/threatlens?sslmode=require
DATABASE_URL=postgresql://postgres:password@localhost:5432/threatlens

# Google OAuth2 Credentials (for Live Gmail Ingestion)
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback
